# Environment Variables
# Copy this file to .env.local and fill in your values

# Upstash Redis (for rate limiting & caching)
# Get free credentials at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Optional: Apify API Token (for story/profile fetching)
# Get at https://apify.com
# APIFY_API_TOKEN=apify_api_xxx
